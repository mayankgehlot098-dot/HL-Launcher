<?xml version="1.0" encoding="utf-8"?>
<!-- HL Launcher: Action button / menu card background -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33B060FF" />
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="#80B060FF" />
        </shape>
    </item>
    <!-- Normal state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#12FFFFFF" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#20B060FF" />
        </shape>
    </item>
</selector>
