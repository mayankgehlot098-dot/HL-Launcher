<?xml version="1.0" encoding="utf-8"?>
<!-- HL Launcher: Bottom version and play bar background -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#F50D091A"
                android:centerColor="#EA120C24"
                android:endColor="#D5160E2C"
                android:type="linear" />
            <corners
                android:topLeftRadius="18dp"
                android:topRightRadius="18dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <stroke android:width="1dp" android:color="#33B060FF" />
        </shape>
    </item>
</layer-list>
