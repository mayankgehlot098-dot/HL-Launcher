<?xml version="1.0" encoding="utf-8"?>
<!-- HL Launcher: Sidebar navigation item background -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected/active state -->
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#2A1855" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <!-- Left accent indicator bar -->
            <item android:right="0dp" android:top="0dp" android:bottom="0dp" android:left="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent"/>
                    <stroke android:width="0dp" android:color="@android:color/transparent"/>
                    <corners android:radius="10dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E1440" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Normal state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
