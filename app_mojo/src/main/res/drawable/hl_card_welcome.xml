<?xml version="1.0" encoding="utf-8"?>
<!-- HL Launcher: Welcome banner glassmorphism card -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#26B060FF"
                android:centerColor="#14180F33"
                android:endColor="#1E0D091A"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#40B060FF" />
        </shape>
    </item>
</layer-list>
