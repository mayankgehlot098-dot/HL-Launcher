<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light or not? -->
    <style name="MojoLauncher" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:navigationBarColor">@color/hl_bg_deep</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="dialogCornerRadius">12dp</item>
        <item name="android:seekBarStyle">@style/MojoLauncher.SeekBar</item>
        <item name="seekBarStyle">@style/MojoLauncher.SeekBar</item>
        <item name="android:switchStyle">@style/MojoLauncher.Switch</item>
        <item name="switchStyle">@style/MojoLauncher.Switch</item>
        <item name="buttonStyle">@style/MojoLauncher.Button</item>
        <item name="android:buttonStyleToggle">@style/MojoLauncher.Button.Toggle</item>
        <item name="android:colorBackground">@color/hl_bg_deep</item>
        <item name="colorPrimary">@color/hl_purple_primary</item>
        <item name="colorAccent">@color/hl_purple_bright</item>
    </style>

    <style name="MojoLauncher.AppTheme" parent="MojoLauncher"/>

    <style name="MojoLauncher.SeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/minepb_progress</item>
        <item name="android:thumb">@drawable/mineknob_on_unfiltered</item>
        <item name="android:thumbOffset">0dp</item>
        <item name="android:maxHeight">4dp</item>
        <item name="android:minHeight">4dp</item>
    </style>

    <style name="MojoLauncher.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="track">@drawable/mineknob_track_mask_unfiltered</item>
        <item name="trackTint">@color/mineknob_track_tint</item>
        <item name="trackTintMode">multiply</item>
        <item name="android:thumb">@drawable/mineknob_switch</item>
        <item name="switchMinWidth">40dp</item>
    </style>

    <style name="MojoLauncher.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_flat</item>
    </style>

    <style name="MojoLauncher.Button.Toggle" parent="MojoLauncher.Button">
        <item name="android:background">@drawable/button_flat_toggle</item>
    </style>


    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/hl_action_button_bg</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">@dimen/_54sdp</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:layout_marginVertical">4dp</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <!-- ═══════════════════════════════════════════ -->
    <!-- HL Launcher Glassmorphism Design System     -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════ -->
    <!-- HL Launcher Glassmorphism Design System     -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Base HL style to satisfy AAPT dot-notation inheritance -->
    <style name="HL" />
    <style name="HL.Button" parent="HL" />

    <!-- Glass card panel -->
    <style name="HL.GlassCard" parent="HL">
        <item name="android:background">@drawable/hl_glass_card</item>
        <item name="android:padding">12dp</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- Elevated glass card -->
    <style name="HL.GlassCard.Elevated" parent="HL.GlassCard">
        <item name="android:background">@drawable/hl_glass_card_elevated</item>
        <item name="android:elevation">8dp</item>
    </style>

    <!-- HL primary button (purple gradient glow) -->
    <style name="HL.Button.Primary" parent="HL.Button">
        <item name="android:background">@drawable/hl_button_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:gravity">center</item>
        <item name="android:elevation">6dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Sidebar navigation item -->
    <style name="HL.NavItem" parent="HL">
        <item name="android:background">@drawable/hl_nav_item_bg</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Sidebar nav item text -->
    <style name="HL.NavItem.Text" parent="HL.NavItem">
        <item name="android:textColor">@color/hl_sidebar_text_inactive</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginStart">10dp</item>
    </style>

    <!-- Section header in sidebar -->
    <style name="HL.SectionLabel" parent="HL">
        <item name="android:textColor">@color/hl_purple_glow</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- HL tagline text -->
    <style name="HL.Tagline" parent="HL">
        <item name="android:textColor">@color/hl_purple_glow</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:alpha">0.85</item>
    </style>

    <!-- HL title text -->
    <style name="HL.Title" parent="HL">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Status badge chip -->
    <style name="HL.Badge" parent="HL">
        <item name="android:background">@drawable/hl_badge_bg</item>
        <item name="android:textColor">@color/hl_purple_glow</item>
        <item name="android:textSize">10sp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

</resources>
