<?xml version="1.0" encoding="utf-8"?>
<!-- HL Launcher: Modern Glassmorphism Dashboard (Portrait) -->
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/fragment_menu_main"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/hl_bg_deep">

	<!-- ══════════════════════════════════════════════════════ -->
	<!--  SCROLLABLE CONTENT AREA                              -->
	<!-- ══════════════════════════════════════════════════════ -->
	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:fillViewport="true"
		android:overScrollMode="never"
		android:scrollbars="none"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintBottom_toTopOf="@id/hl_bottom_dock">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingHorizontal="14dp"
			android:paddingTop="12dp"
			android:paddingBottom="16dp">

			<!-- ────────────────────────────────────────── -->
			<!--  WELCOME BANNER CARD                      -->
			<!-- ────────────────────────────────────────── -->
			<LinearLayout
				android:id="@+id/hl_welcome_card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:padding="16dp"
				android:layout_marginBottom="14dp"
				android:background="@drawable/hl_card_welcome">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="horizontal"
					android:gravity="center_vertical">

					<ImageView
						android:layout_width="38dp"
						android:layout_height="38dp"
						android:src="@drawable/ic_hl_crown"
						android:layout_marginEnd="12dp"
						android:contentDescription="HL Crown Logo" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/app_short_name"
							android:textColor="#FFFFFF"
							android:textSize="18sp"
							android:textStyle="bold"
							android:letterSpacing="0.04" />

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/app_tagline"
							android:textColor="@color/hl_purple_glow"
							android:textSize="9sp"
							android:textAllCaps="true"
							android:letterSpacing="0.15" />
					</LinearLayout>

					<!-- Status Badge -->
					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="ONLINE"
						android:textSize="9sp"
						android:textStyle="bold"
						android:textColor="#44FF88"
						android:background="@drawable/hl_badge_bg"
						android:paddingHorizontal="8dp"
						android:paddingVertical="3dp"
						android:letterSpacing="0.1" />
				</LinearLayout>

				<View
					android:layout_width="match_parent"
					android:layout_height="1dp"
					android:background="#20B060FF"
					android:layout_marginVertical="10dp" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Java Edition for Mobile • Ready to Play"
					android:textColor="@color/hl_text_secondary"
					android:textSize="11sp" />
			</LinearLayout>

			<!-- ────────────────────────────────────────── -->
			<!--  SECTION: COMMUNITY & DOCS                -->
			<!-- ────────────────────────────────────────── -->
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Community &amp; Help"
				android:textColor="@color/hl_purple_glow"
				android:textSize="10sp"
				android:textStyle="bold"
				android:textAllCaps="true"
				android:letterSpacing="0.15"
				android:layout_marginStart="4dp"
				android:layout_marginBottom="6dp" />

			<androidx.constraintlayout.widget.ConstraintLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="14dp">

				<androidx.constraintlayout.widget.Guideline
					android:id="@+id/center_guideline"
					android:layout_width="0dp"
					android:layout_height="0dp"
					android:orientation="vertical"
					app:layout_constraintGuide_percent="0.5"/>

				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/news_button"
					style="@style/LauncherMenuButton.Universal"
					android:layout_width="0dp"
					android:text="@string/mcl_tab_wiki"
					android:drawableStart="@drawable/ic_px_book"
					app:layout_constraintTop_toTopOf="parent"
					app:layout_constraintStart_toStartOf="parent"
					app:layout_constraintEnd_toStartOf="@id/social_divider" />

				<View
					android:id="@+id/social_divider"
					style="@style/LauncherFragment_Divider"
					android:layout_marginVertical="@dimen/padding_large"
					app:layout_constraintTop_toTopOf="parent"
					app:layout_constraintStart_toStartOf="@id/center_guideline"
					app:layout_constraintEnd_toEndOf="@id/center_guideline"
					app:layout_constraintBottom_toBottomOf="@id/news_button"/>

				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/social_media_button"
					style="@style/LauncherMenuButton.Universal"
					android:layout_width="0dp"
					android:text="@string/mcl_button_social_media"
					android:drawableStart="@drawable/ic_social_media"
					app:layout_constraintTop_toTopOf="parent"
					app:layout_constraintStart_toEndOf="@id/social_divider"
					app:layout_constraintEnd_toEndOf="parent"/>
			</androidx.constraintlayout.widget.ConstraintLayout>

			<!-- ────────────────────────────────────────── -->
			<!--  SECTION: LAUNCHER TOOLS                  -->
			<!-- ────────────────────────────────────────── -->
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Launcher Tools"
				android:textColor="@color/hl_purple_glow"
				android:textSize="10sp"
				android:textStyle="bold"
				android:textAllCaps="true"
				android:letterSpacing="0.15"
				android:layout_marginStart="4dp"
				android:layout_marginBottom="6dp" />

			<com.kdt.mcgui.LauncherMenuButton
				android:id="@+id/custom_control_button"
				style="@style/LauncherMenuButton.Universal"
				android:layout_width="match_parent"
				android:drawableStart="@drawable/ic_px_gamepad"
				android:text="@string/mcl_option_customcontrol" />

			<com.kdt.mcgui.LauncherMenuButton
				android:id="@+id/install_jar_button"
				style="@style/LauncherMenuButton.Universal"
				android:layout_width="match_parent"
				android:drawableStart="@drawable/ic_px_java_run"
				android:text="@string/main_install_jar_file" />

			<com.kdt.mcgui.LauncherMenuButton
				android:id="@+id/open_files_button"
				style="@style/LauncherMenuButton.Universal"
				android:layout_width="match_parent"
				android:drawableStart="@drawable/ic_px_folder"
				android:text="@string/mcl_button_open_directory" />

			<com.kdt.mcgui.LauncherMenuButton
				android:id="@+id/share_logs_button"
				style="@style/LauncherMenuButton.Universal"
				android:layout_width="match_parent"
				android:drawableStart="@drawable/ic_px_sharelog"
				android:text="@string/main_share_logs" />

		</LinearLayout>
	</ScrollView>

	<!-- ══════════════════════════════════════════════════════ -->
	<!--  BOTTOM LAUNCH CONSOLE                                -->
	<!-- ══════════════════════════════════════════════════════ -->
	<androidx.constraintlayout.widget.ConstraintLayout
		android:id="@+id/hl_bottom_dock"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@drawable/hl_version_bar_bg"
		android:paddingHorizontal="14dp"
		android:paddingTop="12dp"
		android:paddingBottom="14dp"
		app:layout_constraintBottom_toBottomOf="parent">

		<!-- Version selector bar -->
		<com.kdt.mcgui.mcVersionSpinner
			android:id="@+id/mc_version_spinner"
			android:layout_width="0dp"
			android:layout_height="@dimen/_52sdp"
			android:background="@drawable/hl_action_button_bg"
			android:drawableEnd="@drawable/spinner_arrow"
			app:drawableEndSize="@dimen/padding_heavy"
			app:drawableStartIntegerScaling="true"
			app:drawableStartSize="@dimen/_36sdp"
			app:drawableEndPadding="@dimen/_1sdp"
			app:layout_constraintTop_toTopOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintEnd_toStartOf="@+id/edit_profile_button" />

		<!-- Edit profile button -->
		<ImageButton
			android:id="@+id/edit_profile_button"
			android:layout_width="@dimen/_52sdp"
			android:layout_height="@dimen/_52sdp"
			android:layout_marginStart="8dp"
			android:background="@drawable/hl_action_button_bg"
			android:src="@drawable/ic_px_edit"
			android:tint="@color/hl_purple_glow"
			app:tint="@color/hl_purple_glow"
			android:contentDescription="Edit Profile"
			app:layout_constraintTop_toTopOf="@id/mc_version_spinner"
			app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner"
			app:layout_constraintEnd_toEndOf="parent" />

		<!-- Background display view (retained for layout compat) -->
		<View
			android:id="@+id/_background_display_view"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:visibility="gone"
			app:layout_constraintTop_toTopOf="parent"
			app:layout_constraintBottom_toBottomOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintEnd_toEndOf="parent" />

		<!-- Large Glowing PLAY Button -->
		<com.kdt.mcgui.MineButton
			android:id="@+id/play_button"
			android:layout_width="match_parent"
			android:layout_height="@dimen/_56sdp"
			android:layout_marginTop="10dp"
			android:textAllCaps="true"
			android:text="@string/main_play"
			android:textColor="#FFFFFF"
			android:textSize="18sp"
			android:elevation="6dp"
			app:layout_constraintTop_toBottomOf="@id/mc_version_spinner"
			app:layout_constraintBottom_toBottomOf="parent" />

	</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
